{
	"schemaVersion": 1,
	"id": "virtualminecraft",
	"version": "${version}",
	"name": "VirtualMinecraft",
	"description": "Real computers in Minecraft: QEMU/KVM virtual machines rendered on in-game monitors, multiplayer-aware.",
	"authors": [
		"BwahFox"
	],
	"contact": {},
	"license": "MIT",
	"icon": "assets/virtualminecraft/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"dev.virtualminecraft.VirtualMinecraft"
		],
		"client": [
			"dev.virtualminecraft.client.VirtualMinecraftClient"
		]
	},
	"mixins": [
		"virtualminecraft.mixins.json",
		{
			"config": "virtualminecraft.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}
